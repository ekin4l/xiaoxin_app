<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/ai_agent_overlay"
    android:layout_width="340dp"
    android:layout_height="wrap_content"
    android:elevation="50dp"
    app:cardCornerRadius="20dp"
    app:cardElevation="30dp"
    app:cardBackgroundColor="@color/white"
    android:visibility="gone">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="14dp">

        <!-- Title Bar -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="10dp">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <View
                    android:layout_width="28dp"
                    android:layout_height="28dp"
                    android:background="@drawable/bg_ai_icon" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="小新 AI 助理"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:textColor="@color/zinc_900"
                    android:letterSpacing="0.1"
                    android:layout_marginStart="10dp" />

            </LinearLayout>

            <ImageButton
                android:id="@+id/btn_close_ai"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@drawable/ic_x_small"
                android:background="@android:color/transparent"
                android:scaleType="centerInside"
                android:contentDescription="关闭" />

        </LinearLayout>

        <!-- Content Area -->
        <FrameLayout
            android:id="@+id/ai_content_container"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="140dp"
            android:layout_marginBottom="12dp">

            <!-- Default State: Suggestions -->
            <LinearLayout
                android:id="@+id/ai_suggestions_view"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="visible">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="你可以这样问我："
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:textColor="@color/zinc_400"
                    android:letterSpacing="0.1"
                    android:layout_marginStart="4dp"
                    android:layout_marginBottom="4dp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/ai_suggestion_1"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="帮我找找附近停车方便的咖啡馆"
                        android:textSize="13sp"
                        android:textStyle="bold"
                        android:textColor="@color/zinc_500"
                        android:background="@drawable/bg_ai_suggestion"
                        android:paddingStart="12dp"
                        android:paddingEnd="12dp"
                        android:paddingTop="6dp"
                        android:paddingBottom="6dp"
                        android:gravity="start|center_vertical"
                        android:minHeight="0dp"
                        android:minWidth="0dp"
                        android:clickable="true"
                        android:focusable="true" />

                    <TextView
                        android:id="@+id/ai_suggestion_2"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="推荐一下周边的亲子乐园"
                        android:textSize="13sp"
                        android:textStyle="bold"
                        android:textColor="@color/zinc_500"
                        android:background="@drawable/bg_ai_suggestion"
                        android:paddingStart="12dp"
                        android:paddingEnd="12dp"
                        android:paddingTop="6dp"
                        android:paddingBottom="6dp"
                        android:gravity="start|center_vertical"
                        android:minHeight="0dp"
                        android:minWidth="0dp"
                        android:clickable="true"
                        android:focusable="true"
                        android:layout_marginTop="2dp" />

                    <TextView
                        android:id="@+id/ai_suggestion_3"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="避开拥堵，去三里屯怎么走？"
                        android:textSize="13sp"
                        android:textStyle="bold"
                        android:textColor="@color/zinc_500"
                        android:background="@drawable/bg_ai_suggestion"
                        android:paddingStart="12dp"
                        android:paddingEnd="12dp"
                        android:paddingTop="6dp"
                        android:paddingBottom="6dp"
                        android:gravity="start|center_vertical"
                        android:minHeight="0dp"
                        android:minWidth="0dp"
                        android:clickable="true"
                        android:focusable="true"
                        android:layout_marginTop="2dp" />

                </LinearLayout>

            </LinearLayout>

            <!-- Thinking State -->
            <LinearLayout
                android:id="@+id/ai_thinking_view"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center"
                android:visibility="gone"
                android:paddingTop="16dp"
                android:paddingBottom="16dp">

                <TextView
                    android:id="@+id/ai_thinking_text"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text=""
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:textColor="@color/zinc_900"
                    android:layout_marginBottom="10dp" />

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginStart="4dp">

                    <View
                        android:layout_width="6dp"
                        android:layout_height="6dp"
                        android:background="@drawable/bg_thinking_dot" />

                    <View
                        android:layout_width="6dp"
                        android:layout_height="6dp"
                        android:background="@drawable/bg_thinking_dot"
                        android:layout_marginStart="4dp" />

                    <View
                        android:layout_width="6dp"
                        android:layout_height="6dp"
                        android:background="@drawable/bg_thinking_dot"
                        android:layout_marginStart="4dp" />

                </LinearLayout>

            </LinearLayout>

            <!-- Result State -->
            <LinearLayout
                android:id="@+id/ai_result_view"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center"
                android:visibility="gone"
                android:paddingTop="24dp"
                android:paddingBottom="24dp">

                <TextView
                    android:id="@+id/ai_result_text"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text=""
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:textColor="@color/zinc_900"
                    android:gravity="center"
                    android:lineSpacingExtra="4dp" />

            </LinearLayout>

        </FrameLayout>

        <!-- Input Area -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingTop="12dp"
            android:background="@drawable/divider_horizontal_top">

            <EditText
                android:id="@+id/ai_input"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:hint="输入需求..."
                android:textSize="14sp"
                android:textStyle="bold"
                android:textColorHint="@color/zinc_400"
                android:textColor="@color/zinc_900"
                android:background="@drawable/bg_ai_input"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:paddingTop="12dp"
                android:paddingBottom="12dp"
                android:inputType="text"
                android:imeOptions="actionSend"
                android:singleLine="true" />

            <ImageButton
                android:id="@+id/btn_ai_send"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:src="@drawable/ic_send"
                android:background="@drawable/bg_ai_send_button"
                android:scaleType="centerInside"
                android:padding="10dp"
                android:layout_marginStart="8dp"
                android:contentDescription="发送"
                app:tint="@color/white" />

        </LinearLayout>

    </LinearLayout>

</androidx.cardview.widget.CardView>
