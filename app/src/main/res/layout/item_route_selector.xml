<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="@dimen/spacing_sm"
    app:cardCornerRadius="@dimen/card_corner_radius"
    app:cardElevation="@dimen/elevation_sm"
    app:strokeWidth="1dp"
    app:strokeColor="@color/divider">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="@dimen/route_card_padding">

        <!-- Route Type Badge -->
        <TextView
            android:id="@+id/tv_route_type"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:paddingTop="4dp"
            android:paddingBottom="4dp"
            android:textSize="12sp"
            android:textStyle="bold"
            tools:text="推荐"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <!-- Selected Indicator -->
        <ImageView
            android:id="@+id/iv_selected"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:src="@android:drawable/checkbox_on_background"
            android:contentDescription="已选择"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:tint="@color/blue_600" />

        <!-- Route Name -->
        <TextView
            android:id="@+id/tv_route_name"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/spacing_md"
            android:layout_marginTop="@dimen/spacing_sm"
            android:textSize="16sp"
            android:textColor="@color/text_primary"
            android:textStyle="bold"
            tools:text="推荐路线"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toStartOf="@id/iv_selected"
            app:layout_constraintTop_toBottomOf="@id/tv_route_type" />

        <!-- Route Description -->
        <TextView
            android:id="@+id/tv_route_description"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:textSize="14sp"
            android:textColor="@color/text_secondary"
            tools:text="经由京藏高速"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toStartOf="@id/tv_route_duration"
            app:layout_constraintTop_toBottomOf="@id/tv_route_name" />

        <!-- Distance -->
        <TextView
            android:id="@+id/tv_route_distance"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_sm"
            android:textSize="14sp"
            android:textColor="@color/text_primary"
            android:textStyle="bold"
            tools:text="15.0公里"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/tv_route_description" />

        <!-- Duration -->
        <TextView
            android:id="@+id/tv_route_duration"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/spacing_md"
            android:textSize="14sp"
            android:textColor="@color/blue_600"
            android:textStyle="bold"
            tools:text="20分钟"
            app:layout_constraintStart_toEndOf="@id/tv_route_distance"
            app:layout_constraintTop_toTopOf="@id/tv_route_distance" />

        <!-- Traffic Lights -->
        <TextView
            android:id="@+id/tv_route_traffic_lights"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/spacing_md"
            android:layout_marginTop="@dimen/spacing_sm"
            android:textSize="12sp"
            android:textColor="@color/text_tertiary"
            android:drawableStart="@android:drawable/ic_menu_call"
            android:drawablePadding="4dp"
            tools:text="8个红绿灯"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/tv_route_distance" />

        <!-- Toll Info -->
        <TextView
            android:id="@+id/tv_route_toll"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/spacing_md"
            android:layout_marginTop="@dimen/spacing_sm"
            android:textSize="12sp"
            android:textColor="@color/warning"
            android:drawableStart="@android:drawable/ic_menu_info_details"
            android:drawablePadding="4dp"
            tools:text="收费 25元"
            app:layout_constraintStart_toEndOf="@id/tv_route_traffic_lights"
            app:layout_constraintTop_toTopOf="@id/tv_route_traffic_lights" />

    </androidx.constraintlayout.widget.ConstraintLayout>

</androidx.cardview.widget.CardView>
