<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/container"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background_primary">

    <!-- Sidebar Navigation -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/sidebar"
        android:layout_width="@dimen/sidebar_width"
        android:layout_height="0dp"
        android:background="@color/background_sidebar"
        android:elevation="@dimen/elevation_md"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent">

        <!-- Home Nav Item -->
        <LinearLayout
            android:id="@+id/nav_home"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center"
            android:padding="@dimen/sidebar_item_padding"
            android:background="@drawable/bg_sidebar_item_selected"
            android:clickable="true"
            android:focusable="true"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toTopOf="@id/nav_music">

            <ImageView
                android:id="@+id/nav_home_icon"
                android:layout_width="@dimen/sidebar_icon_size"
                android:layout_height="@dimen/sidebar_icon_size"
                android:src="@drawable/ic_sidebar_home_selected"
                android:contentDescription="@string/nav_home" />

            <TextView
                android:id="@+id/nav_home_label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/nav_home"
                android:textSize="10sp"
                android:textColor="@color/blue_600"
                android:layout_marginTop="4dp" />
        </LinearLayout>

        <!-- Music Nav Item -->
        <LinearLayout
            android:id="@+id/nav_music"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center"
            android:padding="@dimen/sidebar_item_padding"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:clickable="true"
            android:focusable="true"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toBottomOf="@id/nav_home"
            app:layout_constraintBottom_toTopOf="@id/nav_notifications">

            <ImageView
                android:id="@+id/nav_music_icon"
                android:layout_width="@dimen/sidebar_icon_size"
                android:layout_height="@dimen/sidebar_icon_size"
                android:src="@drawable/ic_sidebar_music"
                android:contentDescription="@string/nav_music" />

            <TextView
                android:id="@+id/nav_music_label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/nav_music"
                android:textSize="10sp"
                android:textColor="@color/text_secondary"
                android:layout_marginTop="4dp" />
        </LinearLayout>

        <!-- Notifications Nav Item -->
        <LinearLayout
            android:id="@+id/nav_notifications"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center"
            android:padding="@dimen/sidebar_item_padding"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:clickable="true"
            android:focusable="true"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toBottomOf="@id/nav_music"
            app:layout_constraintBottom_toTopOf="@id/nav_settings">

            <ImageView
                android:id="@+id/nav_notifications_icon"
                android:layout_width="@dimen/sidebar_icon_size"
                android:layout_height="@dimen/sidebar_icon_size"
                android:src="@drawable/ic_sidebar_bell"
                android:contentDescription="@string/nav_notifications" />

            <TextView
                android:id="@+id/nav_notifications_label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/nav_notifications"
                android:textSize="10sp"
                android:textColor="@color/text_secondary"
                android:layout_marginTop="4dp" />
        </LinearLayout>

        <!-- Settings Nav Item -->
        <LinearLayout
            android:id="@+id/nav_settings"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center"
            android:padding="@dimen/sidebar_item_padding"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:clickable="true"
            android:focusable="true"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toBottomOf="@id/nav_notifications">

            <ImageView
                android:id="@+id/nav_settings_icon"
                android:layout_width="@dimen/sidebar_icon_size"
                android:layout_height="@dimen/sidebar_icon_size"
                android:src="@drawable/ic_sidebar_settings"
                android:contentDescription="@string/nav_settings" />

            <TextView
                android:id="@+id/nav_settings_label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/nav_settings"
                android:textSize="10sp"
                android:textColor="@color/text_secondary"
                android:layout_marginTop="4dp" />
        </LinearLayout>

    </androidx.constraintlayout.widget.ConstraintLayout>

    <!-- Nav Host Fragment -->
    <androidx.fragment.app.FragmentContainerView
        android:id="@+id/nav_host_fragment"
        android:name="androidx.navigation.fragment.NavHostFragment"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:defaultNavHost="true"
        app:navGraph="@navigation/mobile_navigation"
        app:layout_constraintStart_toEndOf="@id/sidebar"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
